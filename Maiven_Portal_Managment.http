@Maiven_Portal_Managment_HostAddress = http://localhost:5119
@accessToken = REPLACE_WITH_LOGIN_OR_REGISTER_TOKEN

### Register a student account
POST {{Maiven_Portal_Managment_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "student-password",
  "fullName": "Example Student",
  "dateOfBirth": "2000-01-01",
  "gender": "OTHER",
  "phone": null,
  "address": null,
  "avatarUrl": null
}

### Login
POST {{Maiven_Portal_Managment_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "student-password"
}

### Example protected request
GET {{Maiven_Portal_Managment_HostAddress}}/api/example-protected
Authorization: Bearer {{accessToken}}
Accept: application/json
