@host = http://localhost:5119
@studentToken = REPLACE_WITH_STUDENT_TOKEN
@teacherToken = REPLACE_WITH_TEACHER_TOKEN
@adminToken = REPLACE_WITH_ADMIN_TOKEN
@academicYearId = 1
@semesterId = 1
@courseId = 1

### Register a student
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "student-password",
  "fullName": "Example Student",
  "dateOfBirth": "2000-01-01",
  "gender": "OTHER",
  "phone": null,
  "address": null,
  "avatarUrl": null
}

### Login with any active account
# The response user contains one `role` string and `roleUserId` (`USER_ROLES.id`).
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "student-password"
}

### Login as the migration-seeded administrator
POST {{host}}/api/auth/admin/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "123456"
}

### Get the current user (student, teacher, or admin)
# Requires a newly issued token containing `role` and `roleUserId` claims.
GET {{host}}/api/users/me
Authorization: Bearer {{studentToken}}
Accept: application/json

### Update the current user's profile
PUT {{host}}/api/users/profile
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "fullName": "Updated User",
  "dateOfBirth": "2000-01-01",
  "gender": "OTHER",
  "phone": null,
  "address": null,
  "avatarUrl": null
}

### Create a teacher (ADMIN only)
POST {{host}}/api/teachers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "teacher@example.com",
  "password": "teacher-password",
  "fullName": "Example Teacher",
  "dateOfBirth": "1990-01-01",
  "gender": "OTHER",
  "phone": null,
  "address": null,
  "avatarUrl": null
}

### Create an academic year (ADMIN only)
POST {{host}}/api/academic-years
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "2026-2027",
  "startDate": "2026-09-01",
  "endDate": "2027-06-30",
  "status": "ACTIVE"
}

### List academic years (ADMIN only)
GET {{host}}/api/academic-years
Authorization: Bearer {{adminToken}}
Accept: application/json

### Update an academic year (ADMIN only)
PUT {{host}}/api/academic-years/{{academicYearId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "2026-2027",
  "startDate": "2026-08-24",
  "endDate": "2027-07-02",
  "status": "ACTIVE"
}

### Create a semester (ADMIN only)
POST {{host}}/api/semesters
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "academicYearId": {{academicYearId}},
  "name": "Semester 1",
  "startDate": "2026-09-01",
  "endDate": "2027-01-15"
}

### List semesters (ADMIN only)
GET {{host}}/api/semesters
Authorization: Bearer {{adminToken}}
Accept: application/json

### Update a semester (ADMIN only)
PUT {{host}}/api/semesters/{{semesterId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "academicYearId": {{academicYearId}},
  "name": "Semester 1",
  "startDate": "2026-09-01",
  "endDate": "2027-01-20"
}

### Create a course (ADMIN only)
POST {{host}}/api/courses
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "courseCode": "CS101",
  "courseName": "Introduction to Computer Science",
  "credits": 3,
  "description": "Foundational computer science course",
  "status": "ACTIVE"
}

### List courses (public)
GET {{host}}/api/courses?pageNumber=1&pageSize=10
Accept: application/json

### Get a course (public)
GET {{host}}/api/courses/{{courseId}}
Accept: application/json

### Update a course (ADMIN only)
PUT {{host}}/api/courses/{{courseId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "courseName": "Introduction to Computer Science",
  "credits": 4,
  "description": "Updated course description",
  "status": "ACTIVE"
}

### Delete a course (ADMIN only)
DELETE {{host}}/api/courses/{{courseId}}
Authorization: Bearer {{adminToken}}
