# JWT signing secret (minimum 32 bytes; generate a unique random value per environment)
Jwt__Secret=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES

# SQL Server authentication (local development only)
ConnectionStrings__DefaultConnection=Server=localhost;Database=MaivenPortal;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True

# Windows authentication alternative:
# ConnectionStrings__DefaultConnection=Server=localhost;Database=MaivenPortal;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
